{
  "name": "odak-posta",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "description": "Ki\u015fisel, yapay zek\u00e2 destekli e-posta \u00f6nceliklendirme paneli",
  "scripts": {
    "start": "node server.mjs",
    "dev": "node --watch server.mjs",
    "desktop": "electron .",
    "dist:win": "electron-builder --win nsis --x64",
    "check": "node --check server.mjs && node --check electron/main.mjs && node --check electron/preload.cjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.4",
    "pg": "^8.16.3",
    "nodemailer": "^6.9.13"
  },
  "devDependencies": {
    "electron": "43.2.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.odakposta.desktop",
    "productName": "OdakPosta",
    "asar": true,
    "files": [
      "electron/**/*",
      "public/**/*",
      "server.mjs",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@electric-sql/pglite/dist/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "github",
        "releaseType": "release"
      }
    ]
  },
  "engines": {
    "node": ">=20"
  }
}