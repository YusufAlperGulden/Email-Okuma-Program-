# Application
NODE_ENV=development
# Local address; change this to your HTTPS custom domain in production. On
# Render's default onrender.com address, leave it empty and Render is detected.
APP_ORIGIN=http://localhost:8787

# PostgreSQL Database Configuration
# Requires a connection string like postgres://user:pass@host:5432/dbname
DATABASE_URL=
# Use true for a public database with a trusted TLS certificate. Render's
# Blueprint defines this for its managed database; local Postgres is usually false.
DATABASE_SSL=false

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY=buraya-64-karakterlik-rastgele-bir-anahtar-yazin

# Google OAuth — create an OAuth 2.0 Web application in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# On Render's default domain, leave this empty: the callback is derived automatically.
# Set it only for a custom OAuth callback URL.
GOOGLE_REDIRECT_URI=

# Gemini — this value stays on the server; never put it in browser code.
GEMINI_API_KEY=
# You can override this with a Gemini model enabled for your API key.
GEMINI_MODEL=gemini-2.5-flash-lite

# IANA time zone used when interpreting mail deadlines.
APP_TIMEZONE=Europe/Istanbul

# The connected inbox is checked every 15 minutes by default.
# Set this to 0 only if you want to disable background sync explicitly.
AUTO_SYNC_MINUTES=15
