# Application
NODE_ENV=development
# Render deployment address. Do not include a trailing slash.
APP_ORIGIN=https://your-service.onrender.com
# Persistent directory. In Render, attach a disk at /var/data and use this value.
DATA_DIR=/var/data
# Set a long, unique password before making this app reachable from another device.
APP_PASSWORD=degistir-beni-uzun-ve-ozel-bir-sifre
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY=buraya-64-karakterlik-rastgele-bir-anahtar-yazin

# Google OAuth — create an OAuth 2.0 Web application in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-service.onrender.com/auth/google/callback

# Gemini — this value stays on the server; never put it in browser code.
GEMINI_API_KEY=
# You can override this with a Gemini model enabled for your API key.
GEMINI_MODEL=gemini-2.5-flash-lite

# IANA time zone used when interpreting mail deadlines.
APP_TIMEZONE=Europe/Istanbul

# Optional: keep the server running to sync the connected inbox automatically.
# 0 disables background sync. Use a modest value such as 30 or 60 for normal use.
AUTO_SYNC_MINUTES=0
